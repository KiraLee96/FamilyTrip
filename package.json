{
  "name": "family-trip",
  "version": "0.1.0",
  "private": true,
  "description": "家庭出行计划 · 微信小程序首发 + Web 第二步预留",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.0.1",
  "scripts": {
    "build": "pnpm -r --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r --filter \"./apps/**\" run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "test": "pnpm -r --filter \"./apps/**\" run test",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev:server": "pnpm --filter @family-trip/server run dev",
    "dev:client": "pnpm --filter @family-trip/client run dev:h5",
    "build:client": "pnpm --filter @family-trip/client run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tarojs/cli"
    ]
  }
}
