# 服务
NODE_ENV=development
PORT=3000

# 数据库（MySQL 8.4.3）—— v1.4 收口前留空也可启动
# 本批无表、无 DB 访问；v1.4 关系型栈接入后再填真实连接串
DATABASE_URL="mysql://user:password@localhost:3306/family_trip"

# 微信登录（jscode2session）—— 小程序端 wx.login 的 code 在此换 openid
# 成对配置 → 真实 exchanger；开发态皆缺 → 回落开发桩（openid = openid_${code}，
# 每次登录都是新用户，仅限本地联调）；生产缺失/半配置 → 拒绝启动。
# AppID 与小程序 manifest 中的一致；SECRET 在 mp.weixin.qq.com 开发设置中获取。
WECHAT_APPID=
WECHAT_SECRET=

# 令牌签名密钥（HS256）—— 开发态缺省用源码中的 DEFAULT_DEV_SECRET；
# 🔴 该常量是公开的，生产用它等于允许任何人伪造任意用户令牌，故生产强制要求。
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# M3 fail-fast：合规授权汇率源白名单（逗号分隔，源**名称**而非 URL）。
# 生产环境缺失将拒绝启动（FxSourceMisconfiguredError）。
# 开发态可填 PUBLIC_RATE_DEV 启用公开中间价源（不填也会自动补登并 warn）。
# 生产两条路径（二选一，见 docs/FX-汇率接入说明.md）：
#   ① 上线初期（0 成本）：MANUAL_RATE_ENTRY —— 银行牌价人工录入路径
#   ② 规模化后：签约 API 源名（商务采购后替换）
FX_AUTHORIZED_SOURCES=

# CORS：放行的前端预览 origin（H5 预览默认端口 5199），逗号分隔可写多个。
# 联调期如需放开全部来源，可设 CORS_ORIGIN=*
CORS_ORIGIN=http://127.0.0.1:5199

# 媒体公网访问基址：media list 会把 fileKey 拼成可访问 URL 返回（方案 A）。
# 生产接对象存储 / CDN 公网域名；本地联调用占位域名即可（图片不可达，仅验证契约）。
MEDIA_PUBLIC_BASE_URL=https://media.local

# ── 过期行程自动完结（D-2026-10-26-02 P0-1）─────────────────────────────
# 行程过了 end_date（按行程当地时区算）后自动转 FINISHED 并归档成员为历史只读。
# 总开关：false = 一键回滚（定时器不启动，且读路径的惰性流转同时停用），
# 前端「标记完成」按钮已就绪，回滚不需要改客户端。
AUTO_FINISH_ENABLED=true
# 扫描间隔（毫秒，最小 1000）。默认 5 分钟。
AUTO_FINISH_INTERVAL_MS=300000
# 单轮扫描上限，防止一次全表归档把启动期拖住。默认 200。
AUTO_FINISH_BATCH_LIMIT=200
# 读路径惰性流转（GET /trips、GET /trips/:id 返回前先归档已过期行程）。
# 定时器刚重启/任务挂掉时靠它兜底；失败降级为只读不改，不会让读接口 500。
AUTO_FINISH_LAZY_ON_READ=true
