# 服务
NODE_ENV=development
PORT=3000

# 数据库（MySQL 8.4.3）—— v1.4 收口前留空也可启动
# 本批无表、无 DB 访问；v1.4 关系型栈接入后再填真实连接串
DATABASE_URL="mysql://user:password@localhost:3306/family_trip"

# M3 fail-fast：合规授权汇率源白名单（逗号分隔）。
# 生产环境缺失将拒绝启动（FxSourceMisconfiguredError）。
# 接入授权源后再填写；开发态可用空值（回落 DEV_PLACEHOLDER 占位源）。
FX_AUTHORIZED_SOURCES=

# CORS：放行的前端预览 origin（H5 预览默认端口 5199），逗号分隔可写多个。
# 联调期如需放开全部来源，可设 CORS_ORIGIN=*
CORS_ORIGIN=http://127.0.0.1:5199

# 媒体公网访问基址：media list 会把 fileKey 拼成可访问 URL 返回（方案 A）。
# 生产接对象存储 / CDN 公网域名；本地联调用占位域名即可（图片不可达，仅验证契约）。
MEDIA_PUBLIC_BASE_URL=https://media.local
